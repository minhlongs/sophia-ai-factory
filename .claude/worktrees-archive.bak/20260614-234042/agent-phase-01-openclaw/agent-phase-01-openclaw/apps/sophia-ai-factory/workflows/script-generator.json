{
  "name": "Sophia Script Generator",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "generate-script",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "model": "openai/gpt-4-turbo-preview",
        "prompt": "=Generate a 60-second video script about: {{$json.body.topic}}. \n\nStyle: Engaging, fast-paced, for TikTok/Reels.\nTarget Audience: {{$json.body.audience}}.\n\nFormat:\n[Scene 1]: Visual description\n(Voiceover): Text...",
        "options": {
          "temperature": 0.7
        }
      },
      "name": "OpenRouter API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        300,
        300
      ]
    },
    {
      "parameters": {
        "operation": "create",
        "baseId": "appSophiaFactory",
        "table": "Scripts",
        "columnsUi": {
          "columnValues": [
            {
              "fieldId": "Topic",
              "value": "={{$node[\"Webhook\"].json.body.topic}}"
            },
            {
              "fieldId": "Content",
              "value": "={{$json.data.choices[0].message.content}}"
            },
            {
              "fieldId": "Status",
              "value": "generated"
            },
            {
              "fieldId": "Tier",
              "value": "={{$node[\"Webhook\"].json.body.tier}}"
            },
            {
              "fieldId": "UserId",
              "value": "={{$node[\"Webhook\"].json.body.userId}}"
            }
          ]
        }
      },
      "name": "Save to Airtable",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 1,
      "position": [
        500,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "OpenRouter API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenRouter API": {
      "main": [
        [
          {
            "node": "Save to Airtable",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
