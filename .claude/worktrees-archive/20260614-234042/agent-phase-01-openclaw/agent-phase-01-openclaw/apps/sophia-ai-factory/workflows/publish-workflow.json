{
  "name": "Sophia Publish Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "publish-video",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "operation": "upload",
        "resource": "video",
        "title": "={{$json.body.title}}",
        "description": "={{$json.body.description}}",
        "fileContent": "={{$json.body.videoUrl}}",
        "privacyStatus": "public"
      },
      "name": "YouTube Upload",
      "type": "n8n-nodes-base.youtube",
      "typeVersion": 1,
      "position": [
        300,
        300
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "baseId": "appSophiaFactory",
        "table": "Scripts",
        "id": "={{$json.body.scriptId}}",
        "columnsUi": {
          "columnValues": [
            {
              "fieldId": "Status",
              "value": "published"
            }
          ]
        }
      },
      "name": "Update Airtable",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 1,
      "position": [
        500,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "YouTube Upload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "YouTube Upload": {
      "main": [
        [
          {
            "node": "Update Airtable",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
