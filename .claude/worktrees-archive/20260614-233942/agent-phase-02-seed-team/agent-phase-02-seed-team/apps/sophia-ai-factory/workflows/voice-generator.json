{
  "name": "Sophia Voice Generator",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "baseId": "appSophiaFactory",
        "table": "Scripts",
        "triggerField": "Status",
        "triggerValue": "voice_generating"
      },
      "name": "Airtable Trigger",
      "type": "n8n-nodes-base.airtableTrigger",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.elevenlabs.io/v1/text-to-speech/21m00Tcm4TlvDq8ikWAM",
        "authentication": "headerAuth",
        "headerAuth": {
          "item": [
            {
              "key": "xi-api-key",
              "value": "={{$env.ELEVENLABS_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "={{$json.Content}}"
            },
            {
              "name": "model_id",
              "value": "eleven_monolingual_v1"
            }
          ]
        }
      },
      "name": "ElevenLabs API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        300,
        300
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "baseId": "appSophiaFactory",
        "table": "Scripts",
        "id": "={{$node[\"Airtable Trigger\"].json.id}}",
        "columnsUi": {
          "columnValues": [
            {
              "fieldId": "AudioUrl",
              "value": "={{$json.data.url}}"
            },
            {
              "fieldId": "Status",
              "value": "voice_ready"
            }
          ]
        }
      },
      "name": "Update Airtable",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 1,
      "position": [
        500,
        300
      ]
    }
  ],
  "connections": {
    "Airtable Trigger": {
      "main": [
        [
          {
            "node": "ElevenLabs API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "ElevenLabs API": {
      "main": [
        [
          {
            "node": "Update Airtable",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
