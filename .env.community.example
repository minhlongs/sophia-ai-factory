SOPHIA_EDITION=community
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=community_dev_secret_key_minimum_32_characters_long
BETTER_AUTH_URL=http://localhost:3000
BYOK_ENCRYPTION_MASTER_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

# Note: AI Provider Keys (OpenRouter, ElevenLabs, HeyGen, D-ID) are entered
