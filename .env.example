# Payment Gateways

# NOWPayments (Primary — crypto/USDT)
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret
NOWPAYMENTS_WEBHOOK_URL=https://your-domain.com/api/webhooks/nowpayments

# PayOS (Vietnam domestic — backup)
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# API Configuration
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Database (Optional - for advanced features)
DATABASE_URL=postgresql://user:pass@localhost/mekong_lean

# Email (Transactional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# License Generation (RaaS)
RAAS_LICENSE_SECRET=your_32_char_secret_key_here_min_32_chars

# Google Cloud / Stitch MCP (for UI design generation)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
STITCH_API_ENDPOINT=https://aiplatform.googleapis.com

# Environment
NODE_ENV=development
PYTHON_ENV=development
