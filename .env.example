# ============================================================================
# SOPHIA AI FACTORY — ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================================
# Choose your runtime edition:
#   - community  : Free Open-Core Self-Hosted Edition (Apache-2.0 Core)
#   - cloud      : Official Managed Cloud SaaS (https://sophia.agencyos.network)
#   - enterprise : Self-Hosted Commercial / Master ($4,999) with RAAS_LICENSE_KEY
SOPHIA_EDITION=community
NODE_ENV=development

# ============================================================================
# [1] COMMUNITY CORE — SELF-HOSTED ESSENTIALS (Apache-2.0)
# ============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate_with_openssl_rand_base64_32
BETTER_AUTH_URL=http://localhost:3000
# BYOK Master Encryption Key: 32 bytes base64-encoded (e.g. openssl rand -base64 32)
BYOK_MASTER_KEY=generate_with_openssl_rand_base64_32
# Credentials Master Key: 32 bytes hex-encoded (e.g. openssl rand -hex 32)
CREDENTIALS_MASTER_KEY=generate_with_openssl_rand_hex_32

# Optional Telemetry Beacon (checks https://sophia.agencyos.network/api/version for security releases)
SOPHIA_DISABLE_VERSION_BEACON=false

# ============================================================================
# [2] ENTERPRISE & MASTER ($4,999) SELF-HOSTED LICENSE UNLOCK
# ============================================================================
# Obtain a signed license key at https://sophia.agencyos.network/pricing
RAAS_LICENSE_KEY=
RAAS_LICENSE_SECRET=generate_with_openssl_rand_hex_32

# ============================================================================
# [3] MANAGED CLOUD SAAS BILLING & PAYOUTS (Commercial License Required)
# ============================================================================
# NOWPayments (Primary — USDT/Crypto Billing)
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret
NOWPAYMENTS_WEBHOOK_URL=https://your-domain.com/api/webhooks/nowpayments

# PayOS (Vietnam Domestic — Backup Billing)
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# Transactional Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
