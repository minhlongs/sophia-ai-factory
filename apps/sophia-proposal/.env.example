# Anthropic API (Required for AI proposal generation)
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_KEY>

# Anthropic Auth Token (legacy, deprecated)
# ANTHROPIC_AUTH_TOKEN=

# Cloudflare D1 + JWT Auth (CF Workers provides DB binding automatically)
# JWT secret for signing/verifying auth tokens
JWT_SECRET=your-jwt-secret-change-me-in-production
# Internal API secret for service-to-service calls
INTERNAL_API_SECRET=your-internal-api-secret

# Polar.sh Billing (https://polar.sh)
# Get your API keys from: https://polar.sh/dashboard/settings/api
POLAR_API_URL=https://api.polar.sh
POLAR_API_KEY=<YOUR_POLAR_API_KEY>
POLAR_WEBHOOK_SECRET=<YOUR_WEBHOOK_SECRET>
