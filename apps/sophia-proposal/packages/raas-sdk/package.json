{
  "name": "@sophia/raas-sdk",
  "version": "1.0.0",
  "description": "Sophia AI Factory — RaaS (Robot-as-a-Service) SDK",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "sophia",
    "raas",
    "missions",
    "ai-factory"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
