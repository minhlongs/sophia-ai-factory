{
  "name": "@sophia/raas-sdk",
  "version": "2.0.0",
  "description": "Sophia AI Factory — RaaS (Robot-as-a-Service) SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsup"
  },
  "keywords": [
    "sophia",
    "raas",
    "missions",
    "ai-factory",
    "ai-proposals",
    "robot-as-a-service",
    "ai-agents",
    "mcu-credits"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/longtho638-jpg/sophia-ai-factory"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
