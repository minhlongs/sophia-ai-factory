name: Layer Boundary Check
on:
  pull_request:
  push:
    branches: [ main ]
jobs:
  layer-boundaries:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm
      - run: pnpm install
      - run: bash scripts/check-layer-boundaries.sh
        name: Layer boundary check
        continue-on-error: false
