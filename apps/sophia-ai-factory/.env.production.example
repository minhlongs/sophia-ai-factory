# ===========================================
# Sophia AI Factory — Production Environment
# ===========================================
# Platform: Cloudflare Workers (OpenNext)
# Production: https://sophia.agencyos.network
#
# Copy to .dev.vars for local development.
# Set in Cloudflare Dashboard → Workers → Settings → Variables & Secrets.

# --- Auth (REQUIRED) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://sophia.agencyos.network
CRON_SECRET=
INTERNAL_API_SECRET=
TELEGRAM_WEBHOOK_SECRET=
HEALTH_CHECK_SECRET=

# --- App URL (REQUIRED) ---
NEXT_PUBLIC_APP_URL=https://sophia.agencyos.network
NEXT_PUBLIC_IS_CONFIGURED=true

# --- Encryption ---
API_ENCRYPTION_KEY=

# --- AI Services ---
OPENROUTER_API_KEY=
HEYGEN_API_KEY=
ELEVENLABS_API_KEY=

# --- Payments (NOWPayments - USDT TRC20) ---
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_WALLET=

# --- Payments (PayOS - Vietnam domestic backup) ---
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=Sophia AI <noreply@mekongmind.com>

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=

# --- Background Jobs ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Channel APIs (optional — graceful degradation if missing) ---
YOUTUBE_API_KEY=
TIKTOK_API_KEY=

# --- Storage ---
R2_PUBLIC_BASE_URL=

# --- Redis (Upstash) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Observability ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
METRICS_BEARER_TOKEN=
INTROSPECT_TOKEN=

# --- OpenTelemetry (Honeycomb) ---
HONEYCOMB_API_KEY=
HONEYCOMB_DATASET=sophia-prod
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io
OTEL_SERVICE_NAME=sophia-api
OTEL_SAMPLERATE=0.01

# --- Feature Flags ---
WORKFLOW_REAL_LLM_ENABLED=0
BYOK_ENABLED=true

# --- Admin ---
ADMIN_USER=
ADMIN_PASS=
