# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local
.env*.local
CERTIFICATION.md

# Screenshots (verification artifacts, not source code)
checkout-verify-*.png
vi-landing-*.png
polar-payout-*.png

# PWA (generated by next-pwa at build time)
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/swe-worker-*.js
public/fallback-*.js

# Playwright E2E artifacts
/playwright-report/
/test-results/
/playwright/.cache/

# Audit evidence (generated by deploy-audit-*.mjs and verify-core-video-factory.mjs)
plans/reports/deploy-audit-pre-*.json
plans/reports/deploy-audit-post-*.json
plans/reports/deploy-audit-pre-latest.json
plans/reports/deploy-audit-post-latest.json
plans/reports/core-video-factory-proof-*.json
plans/reports/core-video-factory-proof-latest.json

# CEO dashboard audit working artifacts
docs/audit/*/

# CLEO agent runtime artifacts (not part of the app source)
.cleo/
.next/
.open-next/
node_modules/
plans/reports/*.md
.sbom/
.claude/worktrees/
