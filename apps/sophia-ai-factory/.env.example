# Phase 10: Multi-Channel Publisher — REQUIRED env vars
# AES-256-GCM key for encrypting OAuth tokens at rest (32 random bytes, base64-encoded)
OAUTH_TOKEN_ENC_KEY=

# HMAC-SHA256 key for signing OAuth state params (CSRF protection)
OAUTH_STATE_SECRET=

# Your R2 public bucket hostname — MUST be set; no default (fail-closed SSRF guard)
# Example: pub-abc123.r2.dev  (from Cloudflare R2 bucket → Settings → Public URL)
R2_PUBLIC_HOSTNAME=

# Instagram (Facebook App) credentials
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=

# TikTok OAuth2 credentials
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# YouTube / Google OAuth2 credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=

# Webhook verification secrets (HMAC-SHA256)
INSTAGRAM_WEBHOOK_SECRET=
TIKTOK_WEBHOOK_SECRET=
YOUTUBE_WEBHOOK_SECRET=

# Sentry Observability (TIER-2D)
# https://docs.sentry.io/platforms/javascript/guides/nextjs/
#
# NEXT_PUBLIC_SENTRY_DSN is exposed to the browser bundle (safe — rate-limited by Sentry)
NEXT_PUBLIC_SENTRY_DSN=

# SENTRY_DSN used by server/edge runtimes
SENTRY_DSN=

# Used by @sentry/nextjs webpack plugin (build-time) + sentry-cli (CI upload)
# Scope: project:releases only. Rotate quarterly.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=sophia-ai-factory
SENTRY_PROJECT=sophia-ai-factory

# SENTRY_RELEASE defaults to COMMIT_SHA injected by wrangler-set-build-vars.sh
# Set explicitly only for local manual uploads
SENTRY_RELEASE=

# ─── Core App ────────────────────────────────────────────────────────────────
# Public app URL (used in webhook callbacks, OAuth redirects, sign-out). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature flag — distribute UI enablement (1 = on, 0 = off)
NEXT_PUBLIC_DISTRIBUTE_ENABLED=1

# Crisp.im live-chat widget. Empty = widget hidden (default). Get site ID at
# https://app.crisp.chat → Settings → Website Settings → Setup Instructions.
# IMPORTANT: NEXT_PUBLIC_* vars are inlined at BUILD time — set this in
# wrangler.toml [vars] (not via `wrangler secret put`) and re-run `npm run deploy:full`.
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# Build-time SHA injected by deploy:full (do NOT set manually for local dev)
COMMIT_SHA=

# ─── Better Auth ─────────────────────────────────────────────────────────────
# 32+ char random secret for session signing
BETTER_AUTH_SECRET=
# Origin URL for Better Auth (usually equals NEXT_PUBLIC_APP_URL)
BETTER_AUTH_URL=http://localhost:3000

# ─── Inngest (workflow runner) ───────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── Payments — NOWPayments (canonical, USDT crypto) ─────────────────────────
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Optional VN backup (PayOS — feature-flagged via FEATURE_PAYOS=1)
FEATURE_PAYOS=0

# ─── Telegram Bot (@Sophia_Bbot) ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_ID=

# ─── AI Providers (BYOK fallback) ────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
HEYGEN_API_KEY=
HEYGEN_WEBHOOK_SECRET=
FAL_API_KEY=
REPLICATE_API_KEY=
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# ─── Encryption Keys (32-byte base64 each — generate via `openssl rand -base64 32`) ─
API_ENCRYPTION_KEY=
API_KEY_SECRET=
BYOK_MASTER_KEY=
CREDENTIALS_MASTER_KEY=
AUDIT_RECEIPT_SECRET=
AUDIT_HASH_SALT=

# ─── Email / Notifications ───────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@sophia.agencyos.network
SUPPORT_EMAIL=support@sophia.agencyos.network
FOUNDER_EMAIL=

# ─── Cron / Background Jobs ──────────────────────────────────────────────────
# Bearer token required for /api/cron/* endpoints
CRON_SECRET=

# ─── Optional / Feature-Flagged ──────────────────────────────────────────────
# Quota enforcement: when 1, on D1 read failure we deny rather than allow
QUOTA_FAIL_CLOSED=0
# Disable LLM circuit breaker for local dev
DISABLE_LLM_CIRCUIT_BREAKER=0
# Slack webhook for ops alerts
SLACK_OPS_WEBHOOK_URL=

# ─── Notes ───────────────────────────────────────────────────────────────────
# - D1 + R2 bindings are managed via wrangler.toml, NOT this file
# - Production secrets set via `npx wrangler secret put <NAME>` (NOT committed here)
# - This file documents what the app reads. Real secrets stay out of git.
