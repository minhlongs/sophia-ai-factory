      expect(isTierHigherOrEqual('PREMIUM', 'BASIC')).toBe(true);
      expect(isTierHigherOrEqual('ENTERPRISE', 'PREMIUM')).toBe(true);
    });

    it('should return true when current tier is equal', () => {
