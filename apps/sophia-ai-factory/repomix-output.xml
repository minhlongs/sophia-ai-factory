    description: "Choose your target audience and content vertical",
    icon: "🎯",
  },
  {
    number: "02",
    title: "AI Generate",
    description: "Let AI create scripts, videos, and voice-overs",
    icon: "🤖",
  },
  {
    number: "03",
    title: "Publish",
