    "infra:sync": "./scripts/infra-sync.sh",
    "i18n:validate": "node scripts/validate-i18n-keys.mjs",
    "i18n:autofill": "node scripts/auto-fill-i18n-keys.mjs",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:typecheck": "tsc --noEmit --project tsconfig.worker.json",
    "deploy": "next build && node scripts/fix-instrumentation-standalone.mjs && npx @opennextjs/cloudflare build --skipNextBuild && node scripts/inject-scheduled-handler.mjs && wrangler deploy",
