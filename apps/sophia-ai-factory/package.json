{
  "name": "sophia-ai-factory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mock": "NEXT_PUBLIC_MOCK_AI_SERVICES=true next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "setup": "./scripts/setup.sh",
    "verify": "./scripts/verify.sh",
    "verify:green": "./scripts/verify.sh",
    "test": "vitest",
    "pretest": "npm run i18n:validate",
