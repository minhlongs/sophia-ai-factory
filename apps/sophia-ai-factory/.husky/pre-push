#!/usr/bin/env sh
# Sophia AI Factory pre-push gate
# G3 test + G5 audit (high-severity only)
# Bypass: git push --no-verify (DISCOURAGED)
set -e
cd "$(git rev-parse --show-toplevel)/apps/sophia-ai-factory"
echo "[pre-push] G3 test (vitest run)..."
npm run ci:test
echo "[pre-push] G5 audit (npm audit --audit-level=high)..."
npm audit --audit-level=high || echo "[pre-push] WARN: high-severity transitive vulns present (non-blocking, see SOP 9)"
