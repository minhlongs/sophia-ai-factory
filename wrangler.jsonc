{
	// NOTE: D1 database_id is required by Wrangler CLI — not a secret.
	// D1 access requires Cloudflare account authentication.
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "apps/sophia-ai-factory/.open-next/worker.js",
	"name": "sophia-ai-factory",
	"compatibility_date": "2026-03-17",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": "apps/sophia-ai-factory/.open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sophia-raas-db",
			"database_id": "78bd1961-b62d-43bb-b551-0c5d7d389506"
		}
	],
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "sophia-ai-factory"
		}
	],
	"r2_buckets": [
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "sophia-ai-factory-opennext-cache"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"vars": {
		"NEXT_PUBLIC_IS_CONFIGURED": "true",
		"IS_CONFIGURED": "true"
	}

	// === P1-VARS-BEGIN ===
	// vars block managed by P1 — appended above. COMMIT_SHA/DEPLOYED_AT are CF Secrets.
	// === P1-VARS-END ===

	// === P2-CRONS-BEGIN ===
	// P2 appends cron triggers here
	// === P2-CRONS-END ===

	// === P3-CRONS-BEGIN ===
	// P3 appends cron triggers here
	// === P3-CRONS-END ===

	// === P3-KV-BEGIN ===
	// P3 appends KV namespace bindings here
	// === P3-KV-END ===
}